# Writes the git commit into ${OUT} (build_info.h), at every build, but touches the file only when
# the text changes: Ninja's restat (BYPRODUCTS in CMakeLists.txt) then recompiles version.cpp alone,
# and only after a commit or a clean/dirty flip.
# Run as: cmake -DSRC=<repo root> -DOUT=<header> -P build_info.cmake
set(commit "unknown")
set(dirty "")
find_program(GIT_EXE git)
if(GIT_EXE)
    execute_process(COMMAND "${GIT_EXE}" -C "${SRC}" rev-parse --short=7 HEAD
                    OUTPUT_VARIABLE c RESULT_VARIABLE rc OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(rc EQUAL 0 AND c)
        set(commit "${c}")
        # Tracked changes only: an untracked scratch file isn't a different build.
        execute_process(COMMAND "${GIT_EXE}" -C "${SRC}" status --porcelain --untracked-files=no
                        OUTPUT_VARIABLE st RESULT_VARIABLE rc2 ERROR_QUIET)
        if(rc2 EQUAL 0 AND NOT st STREQUAL "")
            set(dirty "-dirty")
        endif()
    endif()
endif()
set(text "// Generated by cmake/build_info.cmake at build time. Do not edit.\n#pragma once\n#define OMBRA_BUILD_COMMIT \"${commit}${dirty}\"\n")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
else()
    set(old "")
endif()
if(NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()
